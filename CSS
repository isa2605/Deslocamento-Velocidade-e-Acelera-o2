:root {
    --bg-color: #0d1117;
    --card-bg: #161b22;
    --border-color: #30363d;
    --text-color: #c9d1d9;
    --accent-color: #238636;
    --accent-hover: #2ea043;
    --input-bg: #0d1117;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

body {
    background-color: var(--bg-color);
    color: var(--text-color);
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    padding: 20px;
}

.container {
    background-color: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    width: 100%;
    max-width: 450px;
    padding: 24px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
}

h1 {
    font-size: 1.4rem;
    margin-bottom: 8px;
    color: #58a6ff;
    text-align: center;
}

p.subtitle {
    font-size: 0.85rem;
    color: #8b949e;
    text-align: center;
    margin-bottom: 20px;
}

.form-group {
    margin-bottom: 16px;
}

label {
    display: block;
    font-size: 0.9rem;
    margin-bottom: 6px;
    color: #c9d1d9;
}

